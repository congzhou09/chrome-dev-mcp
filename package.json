{
  "name": "chrome-dev-mcp",
  "version": "1.1.0",
  "description": "An MCP server for Chrome runtime debugging",
  "main": "dist/index.js",
  "bin": {
    "chrome-dev-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "keywords": [
    "runtime-debug",
    "chrome-debug",
    "mcp"
  ],
  "mcpName": "io.github.congzhou09/chrome-dev-mcp",
  "repository": "https://github.com/congzhou09/chrome-dev-mcp.git",
  "author": "yuancongzhou",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-remote-interface": "^0.34.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^25.8.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
